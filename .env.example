# =============================================================================
#  XH-Agent 环境变量模板
# =============================================================================
#  使用方式：复制为 .env 后按需修改
#    cp .env.example backend/.env
#
#  ── 模式决策（由 LLM_API_KEY 是否为空自动判断）──
#    LLM_API_KEY 为空 → 🔶 演示模式：返回内置模拟数据，不调用远程 API，零成本启动
#    LLM_API_KEY 非空 → 🔷 真实模式：连接 LLM 服务商，三个 Agent 完整工作
#
#  配置优先级：环境变量 > .env 文件 > config.py 硬编码默认值
# =============================================================================


# ═══════════════════════════════════════════════════════════════════════════════
# 1. LLM 通用配置 — 「一行换模型」只需改下面三行
# ═══════════════════════════════════════════════════════════════════════════════

# ---- 【必填】----

# LLM API 密钥
#   留空 → 自动进入演示模式，所有 Agent 返回 schema 完备的模拟数据
#   填入 → 真实调用远程 LLM
#   示例：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=sk-f97454b32d4c4627ae5bfede1501738d

# ---- 【可选项，均有默认值】----

# LLM 服务商标识（大小写不敏感）
#   可选值：openai | deepseek | anthropic | qwen | zhipu | moonshot | siliconflow | local
LLM_PROVIDER=deepseek

# LLM 模型名称
#   DeepSeek 示例：deepseek-chat / deepseek-reasoner
#   OpenAI  示例：gpt-4o / gpt-4-turbo / gpt-3.5-turbo
#   Anthropic 示例：claude-sonnet-5 / claude-opus-4-8
#   Qwen 百炼示例：qwen-turbo / qwen-plus / qwen-max
#   智谱    示例：glm-4-flash / glm-4-plus
LLM_MODEL=deepseek-chat

# LLM API 地址（OpenAI 兼容格式，末尾不加 /v1 以外的路径）
#   DeepSeek      : https://api.deepseek.com/v1
#   硅基流动       : https://api.siliconflow.cn/v1
#   OpenAI        : https://api.openai.com/v1
#   Qwen 百炼     : https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱           : https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama   : http://localhost:11434/v1
#   本地 vLLM     : http://localhost:8000/v1
LLM_BASE_URL=https://api.deepseek.com/v1


# ═══════════════════════════════════════════════════════════════════════════════
# 2. Agent 粒度模型覆盖（可选 — 为空则自动回退到上面的 LLM_MODEL）
# ═══════════════════════════════════════════════════════════════════════════════

# Agent 1「学情诊断」专用模型（只做知识点分类与匹配，模型可小一些）
LLM_MODEL_DIAGNOSIS=

# Agent 2「知识生成」专用模型（需要创造力和准确性，建议大模型）
LLM_MODEL_GENERATION=

# Agent 3「内容审核」专用模型（需要严格判断和推理，建议强推理模型）
LLM_MODEL_AUDIT=


# ═══════════════════════════════════════════════════════════════════════════════
# 3. LLM 调用参数
# ═══════════════════════════════════════════════════════════════════════════════

# 单次 API 调用超时秒数（默认 120，建议 ≥ 10）
#   网络不稳定可适当调大，但不宜超过 300
LLM_TIMEOUT_SECONDS=120

# 失败后最大重试次数（默认 2，即首次 + 2 次重试 = 共 3 次尝试）
#   指数退避间隔：1s → 2s → 4s …
LLM_MAX_RETRIES=2

# 输入文本最大字符数（默认 32000）
#   超长时保留 system_prompt 完整，从中间截断 user_message
#   截断标记：…[内容过长，中间部分已截断]…
LLM_MAX_INPUT_CHARS=32000

# Agent 1「学情诊断」LLM 温度（默认 0.2，低温保证结果稳定一致）
LLM_TEMPERATURE_DIAGNOSIS=0.2

# Agent 2「知识生成」LLM 温度（默认 0.5，中温兼顾内容多样性）
LLM_TEMPERATURE_GENERATION=0.5

# Agent 3「内容审核」LLM 温度（默认 0.1，极低温保证审查严格）
LLM_TEMPERATURE_AUDIT=0.1


# ═══════════════════════════════════════════════════════════════════════════════
# 4. Embedding 向量化配置（ChromaDB 知识库检索用）
# ═══════════════════════════════════════════════════════════════════════════════

# Embedding 服务商
#   chroma → ChromaDB 内置 ONNX 本地模型（all-MiniLM-L6-v2, 384 维，无需 API）
#   openai → OpenAI Embedding（需 LLM_BASE_URL 提供 embedding 端点；DeepSeek 不支持，勿用）
EMBEDDING_PROVIDER=chroma

# Embedding 模型名（仅 EMBEDDING_PROVIDER=openai 时生效）
#   text-embedding-3-small → 1536 维
#   text-embedding-3-large → 3072 维
#   text-embedding-ada-002  → 1536 维
EMBEDDING_MODEL=text-embedding-3-small

# 向量维度（仅 EMBEDDING_PROVIDER=openai 时生效；chroma 模式固定 384 维）
EMBEDDING_DIM=1536


# ═══════════════════════════════════════════════════════════════════════════════
# 5. ChromaDB 向量数据库配置（零配置即可运行，以下按需覆盖）
# ═══════════════════════════════════════════════════════════════════════════════

# 持久化目录（默认 ./data/chroma，相对于 backend/ 启动路径）
CHROMA_PERSIST_DIR=./data/chroma

# 集合名称，同一知识库共享（默认 domain_knowledge）
CHROMA_COLLECTION_NAME=domain_knowledge


# ═══════════════════════════════════════════════════════════════════════════════
# 6. Agent 工作流参数
# ═══════════════════════════════════════════════════════════════════════════════

# Agent 层单次任务最大重试次数（默认 3）
AGENT_MAX_RETRIES=3

# Agent 2 ⇄ Agent 3 辩论最大轮次（默认 3，范围 1~10）
DEBATE_MAX_ROUNDS=3

# 幻觉检测阈值：引用匹配率低于此值判定为幻觉（默认 0.05，范围 0~1）
#   值越低越宽松，值越高越严格
HALLUCINATION_THRESHOLD=0.05

# 个性化适配目标：生成内容与学习者水平的匹配度最低要求（默认 0.85）
ADAPTATION_TARGET=0.85

# 知识覆盖目标：技能缺口覆盖率最低要求（默认 0.90）
COVERAGE_TARGET=0.90


# ═══════════════════════════════════════════════════════════════════════════════
# 7. 应用服务配置
# ═══════════════════════════════════════════════════════════════════════════════

# 调试模式（默认 true）
#   true  → 热重载 + 详细日志 + CORS 宽松
#   false → 生产模式，关闭调试输出
#   合法值：true / false / 1 / 0 / yes / no / on / off
DEBUG=true

# CORS 允许的前端域名，多个用英文逗号分隔（默认 http://localhost:3000）
#   示例：http://localhost:3000,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:3000

# FastAPI 服务监听地址（默认 0.0.0.0 监听所有网卡）
HOST=0.0.0.0

# FastAPI 服务端口（默认 8000）
PORT=8000
