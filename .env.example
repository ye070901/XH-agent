# ============================================================
# LLM 配置（一行换模型）
# ============================================================

# Provider: openai | anthropic | deepseek | local
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 可选：不同 Agent 使用不同模型（不填则默认用 LLM_MODEL）
# LLM_MODEL_DIAGNOSIS=gpt-4o-mini
# LLM_MODEL_GENERATION=gpt-4o
# LLM_MODEL_AUDIT=claude-opus-4-8

# ============================================================
# Embedding 配置
# ============================================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============================================================
# 向量库（ChromaDB 零配置，自动本地持久化）
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma

# ============================================================
# Agent 参数
# ============================================================
DEBATE_MAX_ROUNDS=3

# ============================================================
# 应用
# ============================================================
DEBUG=true
CORS_ORIGINS=http://localhost:3000
HOST=0.0.0.0
PORT=8000
