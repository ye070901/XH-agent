# ═══════════════════════════════════════════════════════════════
#  XH-Agent 环境配置模板
#  复制此文件为 .env 并填入实际值：  copy .env.example .env
#
#  演示模式（默认）：留空 LLM_API_KEY → 自动返回 schema 完备的模拟数据
#  真实模式：         填写 LLM_API_KEY → 走 OpenAI 兼容 API
# ═══════════════════════════════════════════════════════════════

# ============================================================
# 1. LLM 通用配置（一行换模型：改 LLM_PROVIDER + LLM_MODEL）
# ============================================================

# LLM 提供商: openai | anthropic | deepseek | local | 其他 OpenAI 兼容
LLM_PROVIDER=openai

# API Key — 为空自动进入演示模式，填入即启用真实调用
LLM_API_KEY=

# API 端点（留空使用 SDK 默认。切换模型时改这里）
LLM_BASE_URL=https://api.openai.com/v1

# 默认模型名（所有 Agent 共用，可被下方 Agent 粒度配置覆盖）
LLM_MODEL=gpt-4o

# ============================================================
# 2. Agent 粒度模型覆盖（可选，不填则默认用 LLM_MODEL）
# ============================================================

# Agent 1 — 学情诊断: 推荐小模型（只做分类/匹配）
# LLM_MODEL_DIAGNOSIS=gpt-4o-mini

# Agent 2 — 知识生成: 推荐大模型（需要创造力和准确性）
# LLM_MODEL_GENERATION=gpt-4o

# Agent 3 — 内容审核: 推荐强推理模型（需要严格判断）
# LLM_MODEL_AUDIT=claude-sonnet-5

# ============================================================
# 3. LLM 调用参数
# ============================================================

# API 超时秒数（单次请求，不含重试）
LLM_TIMEOUT_SECONDS=120

# 最大重试次数（含首次共 N+1 次，指数退避: 1s→2s→4s...）
LLM_MAX_RETRIES=2

# ============================================================
# 4. 各 Agent 温度预设（可选，覆盖 config.py 中的固定值）
#    诊断/审核用低温保证一致，生成用中温保证多样性
# ============================================================

# LLM_TEMPERATURE_DIAGNOSIS=0.2
# LLM_TEMPERATURE_GENERATION=0.5
# LLM_TEMPERATURE_AUDIT=0.1

# ============================================================
# 5. Embedding 配置（Phase 2 知识库使用）
# ============================================================

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============================================================
# 6. ChromaDB 向量库（零配置，自动本地持久化）
# ============================================================

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=domain_knowledge

# ============================================================
# 7. Agent 工作流参数
# ============================================================

# Agent 单次任务最大重试次数
AGENT_MAX_RETRIES=3

# Agent 2⇄Agent 3 辩论最大轮次
DEBATE_MAX_ROUNDS=3

# 幻觉率上限（超过此值 → 审核不通过）
HALLUCINATION_THRESHOLD=0.05

# 个性化适配率目标（≥此值 → 适配达标）
ADAPTATION_TARGET=0.85

# 知识点覆盖率目标（≥此值 → 覆盖达标）
COVERAGE_TARGET=0.90

# ============================================================
# 8. 应用配置
# ============================================================

# 调试模式: true 开启热重载 + 详细日志，生产环境改 false
DEBUG=true

# CORS 允许的前端域名（逗号分隔多个）
CORS_ORIGINS=http://localhost:3000

# 监听地址和端口
HOST=0.0.0.0
PORT=8000
